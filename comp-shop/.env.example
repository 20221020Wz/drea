# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/comp_shop
# 开发环境可使用 SQLite: sqlite:///./comp_shop.db

# Redis配置 (用于Celery任务队列)
REDIS_URL=redis://localhost:6379/0

# Claude API配置
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-20250514

# 代理IP配置 (可选)
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=

# 飞书机器人配置
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxx
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 爬虫配置
SCRAPE_DELAY_MIN=2.0
SCRAPE_DELAY_MAX=5.0
SCRAPE_MAX_RETRIES=3
SCRAPE_TIMEOUT=30000

# 图片存储路径
IMAGE_STORAGE_PATH=./data/images

# API服务配置
API_HOST=0.0.0.0
API_PORT=8000

# 日志级别
LOG_LEVEL=INFO
